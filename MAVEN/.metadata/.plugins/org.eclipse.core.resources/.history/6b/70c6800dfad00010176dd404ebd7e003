package com.demo.beans;

import java.util.List;

public class Order {
	@Override
	public String toString() {
		return "Order [oid=" + oid + ", plist=" + plist + "]";
	}
	public int getOid() {
		return oid;
	}
	public void setOid(int oid) {
		this.oid = oid;
	}
	public List<Product> getPlist() {
		return plist;
	}
	public void setPlist(List<Product> plist) {
		this.plist = plist;
	}
	private int oid;
	private List<Product> plist;
	public Order() {
		super();
	}
	public Order(int oid, List<Product> plist) {
		super();
		this.oid = oid;
		this.plist = plist;
	}
}
