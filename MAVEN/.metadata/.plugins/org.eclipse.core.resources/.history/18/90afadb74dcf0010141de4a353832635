package com.demo.beans;

public class Items {
	private int iid;
	private String iname;
	private Cart cobj;
	public Items() {
		super();
	}
	public Items(int iid, String iname, Cart cobj) {
		super();
		this.iid = iid;
		this.iname = iname;
		this.cobj = cobj;
	}
	public int getIid() {
		return iid;
	}
	public void setIid(int iid) {
		this.iid = iid;
	}
	public String getIname() {
		return iname;
	}
	public void setIname(String iname) {
		this.iname = iname;
	}
	public Cart getCobj() {
		return cobj;
	}
	public void setCobj(Cart cobj) {
		this.cobj = cobj;
	}
	@Override
	public String toString() {
		return "Items [iid=" + iid + ", iname=" + iname + ", cobj=" + cobj + "]";
	}
	
}
