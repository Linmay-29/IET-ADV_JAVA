package com.demo.beans;

public class Faculty {
	private int id;
	private String name;
	private String specs;
	private Course c1;
	public Faculty() {
		super();
	}
	public Faculty(int id, String name, String specs, Course c1) {
		super();
		this.id = id;
		this.name = name;
		this.specs = specs;
		this.c1 = c1;
	}
	public int getId() {
		return id;
	}
	public void setId(int id) {
		this.id = id;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public String getSpecs() {
		return specs;
	}
	public void setSpecs(String specs) {
		this.specs = specs;
	}
	public Course getC1() {
		return c1;
	}
	public void setC1(Course c1) {
		this.c1 = c1;
	}
	@Override
	public String toString() {
		return "Faculty [id=" + id + ", name=" + name + ", specs=" + specs + ", c1=" + c1 + "]";
	}
	
}
