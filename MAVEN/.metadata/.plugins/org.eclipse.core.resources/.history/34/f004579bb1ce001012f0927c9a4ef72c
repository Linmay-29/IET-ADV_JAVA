package com.demo.test;

import java.util.HashSet;
import java.util.Set;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.cfg.Configuration;

import com.demo.beans.Employee;
import com.demo.beans.Project;

public class SetTest {
	public static void main(String[] args) {
		SessionFactory sf = new Configuration().configure().buildSessionFactory();
		Session session = sf.getCurrentSession();
		Transaction tr = session.beginTransaction();
		Employee e1 = new Employee(1,"Linmay");
		Employee e2 = new Employee(2,"Kunal");
		Employee e3 = new Employee(3,"Cunal");
		Project p1 = new Project(1,"Pro1");
		Project p2 = new Project(2,"Pro2");
		Set<Employee> eset1 = new HashSet<Employee>();
		eset1.add(e1);
		eset1.add(e2);
		p1.setEset(eset1);
		Set<Employee> eset2 = new HashSet<Employee>();
		eset2.add(e2);
		eset2.add(e3);
		p2.setEset(eset2);
		Set<Project> pset1 = new HashSet<Project>();
		tr.commit();
		sf.close();
	}
}
