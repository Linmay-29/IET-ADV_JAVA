package com.demo.beans;

import java.time.LocalDate;

public class User {
	@Override
	public String toString() {
		return "User [uid=" + uid + ", uname=" + uname + ", upass=" + upass + ", udate=" + udate + "]";
	}
	public int getUid() {
		return uid;
	}
	public void setUid(int uid) {
		this.uid = uid;
	}
	public String getUname() {
		return uname;
	}
	public void setUname(String uname) {
		this.uname = uname;
	}
	public String getUpass() {
		return upass;
	}
	public void setUpass(String upass) {
		this.upass = upass;
	}
	public LocalDate getUdate() {
		return udate;
	}
	public void setUdate(LocalDate udate) {
		this.udate = udate;
	}
	public User() {
		super();
	}
	public User(int uid, String uname, String upass, LocalDate udate) {
		super();
		this.uid = uid;
		this.uname = uname;
		this.upass = upass;
		this.udate = udate;
	}
	private int uid;
	private String uname;
	private String upass;
	private LocalDate udate;
}
